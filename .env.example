# CoachBoard environment example. Copy to .env on the server and keep it out of Git.
COACHBOARD_ENV=production
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:////absolute/path/to/app.db
SESSION_COOKIE_SECURE=true

# Optional: comma-separated allowed origins when Socket.IO is served from a different origin.
# Leave blank for same-origin only.
SOCKETIO_CORS_ORIGINS=

# Public URL used in password reset links.
PUBLIC_BASE_URL=https://coachboard.example.com

# Optional SMTP password recovery settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_MAX_AGE=3600

# Enable only for local development troubleshooting.
COACHBOARD_DEBUG=false
